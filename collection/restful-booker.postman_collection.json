  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Take token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.environment.set(\"token\", pm.response.json().token);",
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Token is returned\", () =>",
                  "  pm.expect(pm.response.json().token).to.be.a(\"string\").and.not.empty);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{ \"username\": \"admin\", \"password\": \"password123\" }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Positive Scenarios",
      "item": [
        {
          "name": "Create a booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.environment.set(\"bookingId\", body.bookingid);",
                  "",
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "pm.test(\"Booking is created with the sent data\", () => {",
                  "  pm.expect(body.booking.firstname).to.eql(pm.environment.get(\"firstname\"));",
                  "  pm.expect(body.booking.lastname).to.eql(pm.environment.get(\"lastname\"));",
                  "  pm.expect(body.booking.totalprice).to.eql(Number(pm.environment.get(\"price\")));",
                  "});",
                  "",
                  "pm.test(\"Response time is below 2000 ms\", () =>",
                  "  pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "",
                  "if (pm.response.code === 200) {",
                  "  pm.environment.set(\"bookingId\", pm.response.json().bookingid);",
                  "}",
                  "",
                  "pm.test(\"Successful response matches booking schema\", () => {",
                  "  const schema = {",
                  "    type: \"object\",",
                  "    required: [\"bookingid\", \"booking\"],",
                  "    properties: {",
                  "      bookingid: { type: \"integer\" },",
                  "      booking: {",
                  "        type: \"object\",",
                  "        required: [",
                  "          \"firstname\",",
                  "          \"lastname\",",
                  "          \"totalprice\",",
                  "          \"depositpaid\",",
                  "          \"bookingdates\",",
                  "          \"additionalneeds\"",
                  "        ],",
                  "        properties: {",
                  "          firstname: { type: \"string\" },",
                  "          lastname: { type: \"string\" },",
                  "          totalprice: { type: \"number\" },",
                  "          depositpaid: { type: \"boolean\" },",
                  "          bookingdates: {",
                  "            type: \"object\",",
                  "            required: [\"checkin\", \"checkout\"],",
                  "            properties: {",
                  "              checkin: { type: \"string\" },",
                  "              checkout: { type: \"string\" }",
                  "            }",
                  "          },",
                  "          additionalneeds: { type: \"string\" }",
                  "        }",
                  "      }",
                  "    }",
                  "  };",
                  "",
                  "  pm.response.to.have.jsonSchema(schema);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set(\"firstname\", pm.variables.replaceIn(\"{{$randomFirstName}}\"));",
                  "pm.environment.set(\"lastname\",  pm.variables.replaceIn(\"{{$randomLastName}}\"));",
                  "pm.environment.set(\"price\",     Math.floor(Math.random() * 1000));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n   \"firstname\": \"{{firstname}}\",\n  \"lastname\": \"{{lastname}}\",\n  \"totalprice\": {{price}},\n  \"depositpaid\": true,\n  \"bookingdates\": { \"checkin\": \"2026-11-01\", \"checkout\": \"2026-11-05\" },\n  \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Check bookings after Posting",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "pm.test(\"Stored booking matches the sent data\", () => {",
                  "  pm.expect(b.firstname).to.eql(pm.environment.get(\"firstname\"));",
                  "  pm.expect(b.lastname).to.eql(pm.environment.get(\"lastname\"));",
                  "  pm.expect(b.totalprice).to.eql(Number(pm.environment.get(\"price\")));",
                  "});",
                  "",
                  "const schema = {",
                  "  type: \"object\",",
                  "  required: [",
                  "    \"firstname\",",
                  "    \"lastname\",",
                  "    \"totalprice\",",
                  "    \"depositpaid\",",
                  "    \"bookingdates\",",
                  "    \"additionalneeds\"",
                  "  ],",
                  "  properties: {",
                  "    firstname: { type: \"string\" },",
                  "    lastname: { type: \"string\" },",
                  "    totalprice: { type: \"number\" },",
                  "    depositpaid: { type: \"boolean\" },",
                  "    bookingdates: {",
                  "      type: \"object\",",
                  "      required: [\"checkin\", \"checkout\"],",
                  "      properties: {",
                  "        checkin: { type: \"string\" },",
                  "        checkout: { type: \"string\" }",
                  "      }",
                  "    },",
                  "    additionalneeds: { type: \"string\" } ",
                  "  }",
                  "};",
                  "",
                  "pm.test(\"Response matches booking JSON Schema\", () => {",
                  "  pm.response.to.have.jsonSchema(schema);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          },
          "response": []
        },

          "response": []
        },
        {
          "name": "Change only total price",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Only totalprice is changed\", () => {",
